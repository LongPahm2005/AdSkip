{
  "name": "youtube-ad-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.content.config.js && vite build --config vite.background.config.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:package": "node --test tests/e2e/*.test.js",
    "test:e2e": "npm run build && npm run test:package",
    "check:version": "node scripts/check-version.js",
    "test:archive": "python scripts/verify-archive.py"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
